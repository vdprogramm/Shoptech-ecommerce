{
  "name": "shoptech-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:customer": "cross-env APP_VARIANT=customer expo start",
    "start:shipper": "cross-env APP_VARIANT=shipper expo start",
    "android": "expo run:android",
    "android:customer": "cross-env APP_VARIANT=customer expo run:android",
    "android:shipper": "cross-env APP_VARIANT=shipper expo run:android",
    "build:apk:customer": "cross-env APP_VARIANT=customer ./android/gradlew assembleDebug",
    "build:apk:shipper": "cross-env APP_VARIANT=shipper ./android/gradlew assembleDebug",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-config": "~54.0.14",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "axios": "^1.15.1",
    "cross-env": "^10.1.0",
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "jsc-android": "^250231.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.2",
    "react-native-paper": "^5.15.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0",
    "socket.io-client": "^4.7.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-private-methods": "^8.0.1",
    "@babel/plugin-transform-private-property-in-object": "^8.0.1",
    "@types/react": "~19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "^57.0.9",
    "typescript": "~5.9.2"
  },
  "private": true
